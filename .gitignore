# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Conda / virtual environments
env/
venv/
*.conda
*.egg-info/

# Jupyter checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store

# Build artifacts
build/
dist/

# Data files
data/
*.parquet
*.csv
*.h5

# Notebooks scratch
notebooks/scratchbook.ipynb

# Documentation build artifacts
*.aux
*.dvi
*.lof
*.lot
documentation/**/*.bbl
documentation/**/*.blg
documentation/**/*.bcf
documentation/**/*.out
documentation/**/*.log
documentation/**/*.lol
documentation/**/*.toc
documentation/**/*.nav
documentation/**/*.snm
documentation/**/*.fls
documentation/**/*.fdb_latexmk
documentation/**/*.synctex.gz

# Large binaries: kept out of the repository wherever they turn up.
*.pdf
*.jpg
*.jpeg

# Figures are generated, not stored: regenerate them rather than commit them.
documentation/tex/**/figures/

# Editor swap files
*.sw[a-p]
